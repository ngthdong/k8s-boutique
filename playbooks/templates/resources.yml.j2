---
# Requests and limits per container, keyed by app name.
#
# Generated by playbooks/measure.yml on {{ now(utc=true).strftime('%Y-%m-%d %H:%M UTC') }}
# from {{ measure_samples }} samples taken every {{ measure_interval }} s with the load generator
# running ({{ loadgen_note }}). Do not edit the numbers by hand: measure again.
#
# Measured peaks:
#   app                      CPU (m)   memory (Mi)   samples
{% for app, peak in usage_peaks | dictsort %}
#   {{ '%-24s' | format(app) }} {{ '%7.1f' | format(peak.cpu_m) }}   {{ '%11.1f' | format(peak.memory_mi) }}   {{ '%7d' | format(peak.samples) }}
{% endfor %}
#
# Policy (filter_plugins/k8s_resources.py):
#   CPU request    = peak, rounded up to 10m, at least 10m
#   memory request = peak x 1.25, rounded up to 8Mi, at least 32Mi
#   memory limit   = max(2 x request, request + 64Mi)
#   CPU limit      = max(4 x request, 200m)
measured_resources:
{{ recommended_resources | to_nice_yaml(indent=2) | indent(2, first=true) }}