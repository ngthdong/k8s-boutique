# Online Boutique's own load generator (Locust), used only while measuring
# resource usage. It browses, adds to cart and checks out continuously.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: loadgenerator
  namespace: {{ microservices_namespace }}
spec:
  replicas: 1
  selector:
    matchLabels:
      app: loadgenerator
  template:
    metadata:
      labels:
        app: loadgenerator
    spec:
      containers:
        - name: main
          image: gcr.io/google-samples/microservices-demo/loadgenerator:v0.2.3
          env:
            - name: FRONTEND_ADDR
              value: "frontend:80"
            - name: USERS
              value: "{{ loadgen_users }}"